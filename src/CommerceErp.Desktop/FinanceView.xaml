<UserControl x:Class="CommerceErp.Desktop.FinanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,8" IsEnabled="{Binding IsReady}">
      <TextBlock Text="操作人" VerticalAlignment="Center" Margin="0,0,6,7"/><TextBox IsReadOnly="True" Text="{Binding Actor,UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,0,12,7"/>
      <TextBlock Text="原因" VerticalAlignment="Center" Margin="0,0,6,7"/><TextBox Text="{Binding Reason,UpdateSourceTrigger=PropertyChanged}" Width="200" MaxLength="500" Margin="0,0,12,7"/>
      <Button Content="刷新 / 查询" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,7"/>
      <Button Content="结构核对" Command="{Binding AuditCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,7"/>
      <Button Content="{Binding PendingText}" Command="{Binding RecoverCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,7"/>
    </WrapPanel>
    <TabControl Grid.Row="1" SelectedIndex="{Binding Tab}" Background="Transparent" BorderThickness="0">
      <TabItem Header="1 · 账单导入" Padding="12,9"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel IsEnabled="{Binding IsReady}">
        <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
          <TextBlock Text="保留原始账单，再按明确的列映射导入" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="UTF-8 CSV · 每批最多 500 行 / 120 KB · 金额统一为正数元，方向由类型确定 · 时间需带时区" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,12"/>
          <WrapPanel><ComboBox ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" DisplayMemberPath="Name" Width="130" Margin="0,0,8,8"/><ComboBox ItemsSource="{Binding Shops}" SelectedItem="{Binding SelectedShop}" DisplayMemberPath="Name" Width="170" Margin="0,0,8,8"/><Button Content="选择 CSV" Command="{Binding FileCommand}" Margin="0,0,8,8"/><Button Content="载入格式示例" Command="{Binding SampleCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="本次导入批次号（重试保持原号）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BatchNumber,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="来源文件名" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FileName,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid>
          <Expander Header="列名和交易类型映射（可适配导出的账单列名）" Margin="0,12,0,8"><StackPanel>
            <ItemsControl ItemsSource="{Binding Columns}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Width="140" Margin="0,8,10,0"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="交易类型别名以 | 分隔；未知类型会阻止整批导入。非退款行的售后编号留空。" FontSize="11" Margin="0,10,0,6"/>
            <UniformGrid Columns="4"><StackPanel Margin="0,0,8,0"><TextBlock Text="收入类型"/><TextBox Text="{Binding SaleTypes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="退款类型"/><TextBox Text="{Binding RefundTypes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel Margin="0,0,8,0"><TextBlock Text="平台费类型"/><TextBox Text="{Binding FeeTypes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="运费类型"/><TextBox Text="{Binding FreightTypes,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid>
          </StackPanel></Expander>
          <TextBox Text="{Binding Content,UpdateSourceTrigger=PropertyChanged}" Height="135" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
          <WrapPanel Margin="0,12,0,8"><Button Content="校验并预览" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/><Button Content="确认导入" Command="{Binding ImportCommand}"/><TextBlock Text="{Binding PreviewText}" MaxWidth="650" VerticalAlignment="Center" Margin="14,0,0,0"/></WrapPanel>
          <DataGrid ItemsSource="{Binding Preview.Lines}" Height="180" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="行" Binding="{Binding Line}" Width="45"/><DataGridTextColumn Header="流水号" Binding="{Binding Transaction}" Width="150"/><DataGridTextColumn Header="原订单" Binding="{Binding Order}" Width="180"/><DataGridTextColumn Header="金额" Binding="{Binding Amount,StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="预览结果" Binding="{Binding Match}" Width="260"/></DataGrid.Columns></DataGrid>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="2 · 流水匹配" Padding="12,9"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="账单流水与原始记录" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,8" ToolTip="按流水号或平台订单号搜索，点击顶部查询"/><WrapPanel><CheckBox Content="只看待匹配" IsChecked="{Binding Unmatched}" VerticalAlignment="Center" Margin="0,0,10,8"/><Button Content="重新按编号匹配" Command="{Binding RematchCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel></StackPanel>
          <ComboBox Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Label" Margin="0,0,0,8"/>
          <DataGrid Grid.Row="2" Height="210" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" RowHeight="39"><DataGrid.Columns><DataGridTextColumn Header="流水号" Binding="{Binding Source.Transaction}" Width="155"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="75"/><DataGridTextColumn Header="金额" Binding="{Binding Source.Amount,StringFormat=0.00}" Width="95"/><DataGridTextColumn Header="状态" Binding="{Binding Source.Match}" Width="190"/><DataGridTextColumn Header="原订单" Binding="{Binding Source.ExternalOrderId}" Width="200"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="3" Margin="0,10,0,0"><WrapPanel><Button Content="打开流水" Command="{Binding OpenRowCommand}" Margin="0,0,8,8"/><Button Content="查看批次原文" Command="{Binding OriginalCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/><Button Content="作废所选批次" Command="{Binding VoidCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8"/></WrapPanel><WrapPanel><TextBlock Text="{Binding RowPageText}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="上一页" Command="{Binding RowPreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="下一页" Command="{Binding RowNextCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel>
        </Grid></ScrollViewer></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsReady}">
          <TextBlock Text="人工关联与处理依据" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding BillDetails.Row.Transaction}" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="原始字段（按文件列顺序保留）" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding BillDetails.OriginalRecord,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="65"/>
          <TextBlock Text="查找目标订单（最多返回 100 单，可输入完整订单号）" Style="{StaticResource FieldLabel}"/><DockPanel><Button DockPanel.Dock="Right" Content="查找" Command="{Binding SearchMatchCommand}" Margin="8,0,0,0"/><TextBox Text="{Binding MatchSearch,UpdateSourceTrigger=PropertyChanged}"/></DockPanel>
          <ComboBox ItemsSource="{Binding MatchOrders}" SelectedItem="{Binding MatchOrder}" DisplayMemberPath="Source.ExternalOrderId" Margin="0,8,0,8"/><Button Content="加载该订单可关联售后" Command="{Binding LoadCasesCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/><ComboBox ItemsSource="{Binding MatchCases}" SelectedItem="{Binding MatchCase}" DisplayMemberPath="SourceCaseNumber" Margin="0,8,0,0"/>
          <TextBlock Text="匹配依据" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding MatchEvidence,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" Height="65" MaxLength="1000"/><Button Content="保存人工关联" Command="{Binding MatchCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <TextBlock Text="只允许同平台同店铺；退款须关联已批准售后。人工关联不改变原文，不代表平台核验。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
          <ItemsControl ItemsSource="{Binding BillDetails.History}" Margin="0,14,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Reason}"/><TextBlock Text="{Binding Data}" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer></Border>
      </Grid></TabItem>
      <TabItem Header="3 · 订单对账" Padding="12,9"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="订单结算差异" FontSize="17" FontWeight="SemiBold"/><TextBox Text="{Binding OrderSearch,UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,8" ToolTip="平台订单号；点击顶部查询"/><CheckBox Content="只看待完善订单" IsChecked="{Binding Differences}" Margin="0,0,0,10"/></StackPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" RowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="平台订单号" Binding="{Binding Source.ExternalOrderId}" Width="190"/><DataGridTextColumn Header="核对状态" Binding="{Binding State}" Width="180"/><DataGridTextColumn Header="基础贡献" Binding="{Binding Profit}" Width="110"/></DataGrid.Columns></DataGrid>
          <StackPanel Grid.Row="2" Margin="0,10,0,0"><Button Content="打开订单明细" Command="{Binding OpenOrderCommand}" HorizontalAlignment="Left"/><WrapPanel Margin="0,10,0,0"><TextBlock Text="{Binding OrderPageText}" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="上一页" Command="{Binding OrderPreviousCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="下一页" Command="{Binding OrderNextCommand}" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel>
        </Grid></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsReady}">
          <TextBlock Text="{Binding Details.Order.ExternalOrderId}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Details.Order.ShippingState}" Foreground="{StaticResource Muted}" Margin="0,6,0,8"/><TextBlock Text="{Binding ProblemsText}" Foreground="#965A20" LineHeight="22"/>
          <UniformGrid Columns="3" Margin="0,14,0,4"><StackPanel><TextBlock Text="账单收入" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Details.Order.Income,StringFormat=0.00}" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="账单退款" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Details.Order.Refund,StringFormat=0.00}" FontSize="20"/></StackPanel><StackPanel><TextBlock Text="结算净额" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Details.Order.NetSettlement,StringFormat=0.00}" FontSize="20"/></StackPanel></UniformGrid>
          <WrapPanel Margin="0,8,0,0"><TextBlock Text="商品净成本："/><TextBlock Text="{Binding Details.Order.NetCost,StringFormat=0.00,TargetNullValue=待完善}"/><TextBlock Text="　基础结算贡献："/><TextBlock Text="{Binding Details.Order.Profit,StringFormat=0.00,TargetNullValue=待完善}" FontWeight="SemiBold"/></WrapPanel>
          <TextBlock Text="应扣费用核对（零费用须明确填写 0）" Style="{StaticResource FieldLabel}"/><UniformGrid Columns="2"><StackPanel Margin="0,0,8,0"><TextBlock Text="平台费 / 元" FontSize="11"/><TextBox Text="{Binding ExpectedFee,UpdateSourceTrigger=PropertyChanged}"/></StackPanel><StackPanel><TextBlock Text="运费 / 元" FontSize="11"/><TextBox Text="{Binding ExpectedFreight,UpdateSourceTrigger=PropertyChanged}"/></StackPanel></UniformGrid>
          <TextBlock Text="费用依据" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding FeeEvidence,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="50" MaxLength="1000"/><Button Content="保存应扣费用" Command="{Binding FeesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
          <TextBlock Text="出库成本与良品退回冲回" Style="{StaticResource FieldLabel}"/><DataGrid ItemsSource="{Binding Details.Costs}" Height="160" RowHeight="37"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding SkuCode}" Width="130"/><DataGridTextColumn Header="出库成本" Binding="{Binding Cost,StringFormat=0.00,TargetNullValue=待补录}" Width="110"/><DataGridTextColumn Header="良品冲回" Binding="{Binding ReturnCredit,StringFormat=0.00,TargetNullValue=待补录}" Width="110"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="导出编号" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ExportNumber,UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="目标财务系统 / 接收方" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Target,UpdateSourceTrigger=PropertyChanged}"/><Button Content="为当前对平订单生成交接包" Command="{Binding CreateExportCommand}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <ItemsControl ItemsSource="{Binding Details.History}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding CreatedAt}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Reason}"/><TextBlock Text="{Binding Data}" FontSize="11"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer></Border>
      </Grid></TabItem>
      <TabItem Header="4 · 成本管理" Padding="12,9"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel IsEnabled="{Binding IsReady}">
        <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="未来出库的单位成本" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="手工标准成本，最多六位小数。每次出库冻结快照，修改这里不会追改历史。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,10"/>
          <DataGrid ItemsSource="{Binding SkuCosts}" SelectedItem="{Binding SelectedSku}" Height="135" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="实物 SKU" Binding="{Binding Code}" Width="155"/><DataGridTextColumn Header="单位成本 / 元" Binding="{Binding UnitCost,TargetNullValue=未设置}" Width="150"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="75"/><DataGridTextColumn Header="依据" Binding="{Binding Evidence}" Width="*"/></DataGrid.Columns></DataGrid>
          <WrapPanel Margin="0,10,0,0"><TextBox Text="{Binding CostValue,UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,8" ToolTip="所选 SKU 的单位成本"/><TextBox Text="{Binding CostEvidence,UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,8,8" ToolTip="成本依据，必填"/><Button Content="保存单位成本" Command="{Binding CostCommand}" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="历史出库成本快照" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="缺失项可凭依据补录一次；已有成本不能覆盖。残次品不会冲回商品成本。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,10"/>
          <DataGrid ItemsSource="{Binding Costs}" SelectedItem="{Binding SelectedCost}" Height="210" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="平台订单号" Binding="{Binding ExternalOrderId}" Width="190"/><DataGridTextColumn Header="SKU" Binding="{Binding SkuCode}" Width="130"/><DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="75"/><DataGridTextColumn Header="单位成本" Binding="{Binding UnitCost,TargetNullValue=待补录}" Width="110"/><DataGridTextColumn Header="成本金额" Binding="{Binding Cost,StringFormat=0.00,TargetNullValue=待补录}" Width="110"/><DataGridTextColumn Header="良品冲回" Binding="{Binding ReturnCredit,StringFormat=0.00,TargetNullValue=待补录}" Width="110"/><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="250"/></DataGrid.Columns></DataGrid>
          <WrapPanel Margin="0,10,0,0"><TextBox Text="{Binding HistoricalCost,UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,8" ToolTip="历史单位成本，不是总成本"/><TextBox Text="{Binding HistoricalEvidence,UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,8,8" ToolTip="历史成本依据"/><Button Content="补录选中缺失项" Command="{Binding FillCostCommand}" Margin="0,0,0,8"/></WrapPanel>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="5 · 报表与导出" Padding="12,9"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"><StackPanel>
        <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="基础结算贡献 · 累计口径" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding ReportText}" Foreground="{StaticResource Muted}" Margin="0,7,0,10"/><TextBlock Text="贡献 = 账单收入 − 退款 − 平台费 − 运费 − 出库成本 + 良品退货成本。未包括税费、广告、人工等全部经营费用。" FontSize="11" Margin="0,0,0,10"/>
          <DataGrid ItemsSource="{Binding Report.Shops}" Height="160" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="店铺" Binding="{Binding Key}" Width="220"/><DataGridTextColumn Header="订单" Binding="{Binding Orders}" Width="65"/><DataGridTextColumn Header="待完善" Binding="{Binding Incomplete}" Width="85"/><DataGridTextColumn Header="收入" Binding="{Binding Income,StringFormat=0.00}" Width="100"/><DataGridTextColumn Header="退款" Binding="{Binding Refund,StringFormat=0.00}" Width="100"/><DataGridTextColumn Header="费用" Binding="{Binding Fees,StringFormat=0.00}" Width="90"/><DataGridTextColumn Header="基础贡献" Binding="{Binding Profit,StringFormat=0.00,TargetNullValue=待完善}" Width="120"/></DataGrid.Columns></DataGrid>
          <TextBlock Text="按销售 SKU 分析：收入、退款及费用按原行折后商品额比例分摊，分位采用最大余数法；组合商品成本汇总实物组件。" Style="{StaticResource FieldLabel}"/>
          <DataGrid ItemsSource="{Binding Report.Products}" Height="160" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="销售 SKU" Binding="{Binding SkuCode}" Width="155"/><DataGridTextColumn Header="订单" Binding="{Binding Orders}" Width="65"/><DataGridTextColumn Header="待完善" Binding="{Binding Incomplete}" Width="85"/><DataGridTextColumn Header="分摊收入" Binding="{Binding Income,StringFormat=0.00}" Width="110"/><DataGridTextColumn Header="分摊退款" Binding="{Binding Refund,StringFormat=0.00}" Width="110"/><DataGridTextColumn Header="净成本" Binding="{Binding Cost,StringFormat=0.00,TargetNullValue=待完善}" Width="100"/><DataGridTextColumn Header="基础贡献" Binding="{Binding Profit,StringFormat=0.00,TargetNullValue=待完善}" Width="120"/></DataGrid.Columns></DataGrid>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0"><StackPanel><TextBlock Text="财务交接记录" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="在订单对账页生成快照。当前支持 JSON 明细 + CSV 汇总下载；未连接具体财务软件。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,10"/>
          <DataGrid ItemsSource="{Binding Exports}" SelectedItem="{Binding SelectedExport}" Height="140" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="导出编号" Binding="{Binding Source.Number}" Width="220"/><DataGridTextColumn Header="目标" Binding="{Binding Source.Target}" Width="240"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="230"/><DataGridTextColumn Header="订单数" Binding="{Binding Source.Orders}" Width="90"/></DataGrid.Columns></DataGrid>
          <WrapPanel Margin="0,10,0,8"><Button Content="打开快照" Command="{Binding OpenExportCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="保存 JSON 和 CSV" Command="{Binding SaveExportCommand}"/></WrapPanel><TextBlock Text="{Binding ExportDescription}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="#315D91" Margin="0,12,0,0" MaxHeight="50" ToolTip="{Binding Message}"/>
  </Grid>
</UserControl>
