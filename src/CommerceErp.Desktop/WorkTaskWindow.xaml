<Window x:Class="CommerceErp.Desktop.WorkTaskWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="任务与异常" Width="1240" Height="850" MinWidth="1060" MinHeight="760" WindowStartupLocation="CenterOwner" Background="#F4F7FC">
 <Grid Margin="24" Background="#F4F7FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,14"><TextBlock Text="任务与异常" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="按账号权限查看；共享仓库存事件按仓库授权显示。真实平台连接器尚未配置。" Foreground="#63758C" Margin="0,6,0,10"/><TextBlock x:Name="HealthText" TextWrapping="Wrap" Foreground="#8D5929" Margin="0,0,0,8"/><TextBlock x:Name="SummaryText" FontSize="15" FontWeight="SemiBold"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14"><ComboBox x:Name="KindBox" Width="140" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="全部类型" Tag=""/><ComboBoxItem Content="业务事件" Tag="BusinessEvent"/><ComboBoxItem Content="发货回传" Tag="ShipmentDelivery"/></ComboBox><ComboBox x:Name="StateBox" Width="130" SelectedIndex="0" Margin="0,0,8,0"><ComboBoxItem Content="全部状态" Tag=""/><ComboBoxItem Content="等待处理" Tag="Pending"/><ComboBoxItem Content="处理中" Tag="Processing"/><ComboBoxItem Content="延迟重试" Tag="RetryWait"/><ComboBoxItem Content="结果不明" Tag="Unknown"/><ComboBoxItem Content="条件未满足" Tag="Blocked"/><ComboBoxItem Content="处理失败" Tag="Failed"/><ComboBoxItem Content="平台拒绝" Tag="Rejected"/><ComboBoxItem Content="已确认" Tag="Confirmed"/></ComboBox><TextBox x:Name="SearchBox" Width="220" ToolTip="订单号、库存标识或任务号" Margin="0,0,8,0"/><Button x:Name="SearchButton" Content="查询 / 刷新" Click="Search_Click"/><Button x:Name="PreviousButton" Content="上一页" Click="Previous_Click" Style="{StaticResource SecondaryButton}" Margin="12,0,6,0"/><Button x:Name="NextButton" Content="下一页" Click="Next_Click" Style="{StaticResource SecondaryButton}"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
   <DataGrid x:Name="TasksGrid" SelectionChanged="Selected_Changed" Margin="0,0,16,12"><DataGrid.Columns><DataGridTextColumn Header="任务" Binding="{Binding Title}" Width="125"/><DataGridTextColumn Header="关联单据 / 库存" Binding="{Binding RelatedNumber}" Width="*" ElementStyle="{StaticResource GridValue}"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="95"/><DataGridTextColumn Header="尝试" Binding="{Binding Source.Attempts}" Width="60"/></DataGrid.Columns></DataGrid>
   <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="任务详情" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="IdentityText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Margin="0,8,0,8"/><TextBlock x:Name="MessageText" Foreground="#37628D" LineHeight="23"/><TextBlock x:Name="ScheduleText" Foreground="#63758C" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="重试原因" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ReasonBox" MaxLength="500" Height="68" TextWrapping="Wrap" AcceptsReturn="False"/><Button x:Name="RetryButton" Content="核查后重新排队" Click="Retry_Click" Margin="0,12,0,0"/><TextBlock Text="重新排队保留原任务号，不重新创建订单或扣减库存。未配置连接器的任务仍会被阻断。" Foreground="#63758C" FontSize="11" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="最近 100 条处理与人工重试记录 · 时间为 UTC" FontWeight="SemiBold" Margin="0,0,0,8"/><DataGrid Grid.Row="1" x:Name="HistoryGrid" RowHeight="32"><DataGrid.Columns><DataGridTextColumn Header="处理结果 / 动作" Binding="{Binding Action}" Width="150"/><DataGridTextColumn Header="操作人" Binding="{Binding Source.Actor}" Width="180" ElementStyle="{StaticResource GridValue}"/><DataGridTextColumn Header="原因" Binding="{Binding Source.Reason}" Width="*" ElementStyle="{StaticResource GridValue}"/><DataGridTextColumn Header="开始时间" Binding="{Binding Source.StartedAt}" Width="210" ElementStyle="{StaticResource GridValue}"/><DataGridTextColumn Header="完成时间" Binding="{Binding Source.FinishedAt}" Width="210" ElementStyle="{StaticResource GridValue}"/></DataGrid.Columns></DataGrid></Grid>
  <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#37628D" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </Grid>
</Window>
