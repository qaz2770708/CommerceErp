<UserControl x:Class="CommerceErp.Desktop.InventoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,14"><DockPanel>
      <WrapPanel DockPanel.Dock="Right"><Button Content="调整 / 盘点 / 隔离处置" Command="{Binding InventoryDocumentsCommand}" Margin="0,0,8,0"/><Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button Content="一致性检查" Command="{Binding ConsistencyCommand}"/></WrapPanel>
      <StackPanel><TextBlock Text="可承诺量 = max(0, 在库 − 预占 − 冻结 − 安全库存)" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="隔离库存独立存放，不计入主库在库和可承诺量" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,12,0"/></StackPanel>
    </DockPanel></Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="共享仓库存余额 · 店铺共用" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Inventory}" SelectedItem="{Binding SelectedStock}" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding IsReady}"><DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="SKU" Binding="{Binding SkuCode}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="在库" Binding="{Binding OnHand, StringFormat={}{0:0.###}}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="预占" Binding="{Binding Reserved, StringFormat={}{0:0.###}}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="冻结" Binding="{Binding Frozen, StringFormat={}{0:0.###}}" Width="60"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="安全量" Binding="{Binding Safety, StringFormat={}{0:0.###}}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="隔离" Binding="{Binding Quarantined, StringFormat={}{0:0.###}}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="可承诺" Binding="{Binding Available, StringFormat={}{0:0.###}}" Width="85"/>
          </DataGrid.Columns></DataGrid>
        </Grid></Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="最近 200 条授权范围流水 · 店铺筛选后不能用于全仓对账" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Ledger}" RowHeight="38" HorizontalScrollBarVisibility="Auto"><DataGrid.Columns>
            <DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="SKU" Binding="{Binding SkuCode}" Width="120"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="动作" Binding="{Binding Action, Converter={StaticResource BusinessLabel}}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="在库变动" Binding="{Binding OnHandDelta, StringFormat={}{0:+0.###;-0.###;0}}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="预占变动" Binding="{Binding ReservedDelta, StringFormat={}{0:+0.###;-0.###;0}}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="原因" Binding="{Binding Reason}" Width="210"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="时间 (UTC)" Binding="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="140"/>
          </DataGrid.Columns></DataGrid>
        </Grid></Border>
      </Grid>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsReady}">
        <TextBlock Text="{Binding SelectedStock.SkuCode}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedStock.SkuName}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="本次操作原因（必填）"/><TextBox Text="{Binding StockReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AcceptsReturn="True" Height="65" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="模拟补货数量"/><TextBox Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}"/><Button Content="补货入账" Command="{Binding ReceiveCommand}" HorizontalAlignment="Left" Margin="0,10,0,10"/>
        <Separator Margin="0,8"/><TextBlock Style="{StaticResource FieldLabel}" Text="冻结数量（总量）"/><TextBox Text="{Binding Frozen, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Style="{StaticResource FieldLabel}" Text="安全库存（总量）"/><TextBox Text="{Binding Safety, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="冻结不能占用已预占的库存。策略调整保留版本和流水，不会自动取消已审核订单。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,10,0,12"/>
        <Button Content="保存库存策略" Command="{Binding PolicyCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"/>
        <Button Content="{Binding PendingText}" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0" Padding="10,8"/>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding Message}" Foreground="#37628D" FontSize="12" Margin="0,12,0,0" MaxHeight="52" ToolTip="{Binding Message}"/>
  </Grid>
</UserControl>
