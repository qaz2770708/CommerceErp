<Window x:Class="CommerceErp.Desktop.MasterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="基础资料与期初库存" Width="1300" Height="860" MinWidth="1100" MinHeight="760" Background="#F4F7FC" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterOwner">
 <Grid Margin="24" Background="#F4F7FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,16"><TextBlock Text="基础资料与期初库存" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceText" Margin="0,8,0,8" Foreground="#63758C" TextWrapping="Wrap"/><WrapPanel><Button Content="分页检索" Click="Browse_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/><Button Content="刷新资料" Click="Refresh_Click"/><Button Content="查看所选资料历史" Click="History_Click" Margin="12,0,0,0" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel>
 <TabControl Grid.Row="1" x:Name="Tabs">
 <TabItem Header="企业与店铺"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0"><StackPanel>
 <TextBlock Text="企业名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="EnterpriseBox" MaxLength="100"/><TextBlock Text="仓库名称（当前支持一个仓库）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WarehouseBox" MaxLength="100"/><Button Content="保存企业与仓库" Click="SaveWorkspace_Click" Margin="0,12,0,18"/>
 <TextBlock Text="店铺平台" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ShopPlatform"/><TextBlock Text="平台店铺标识" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShopExternal" MaxLength="100"/><TextBlock Text="店铺名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ShopName" MaxLength="100"/><CheckBox x:Name="ShopEnabled" Content="启用（停用后阻止新接单与新映射，历史保留）" IsChecked="True" Margin="0,12,0,12"/><WrapPanel><Button Content="新建店铺" Click="NewShop_Click" Style="{StaticResource SecondaryButton}"/><Button Content="保存店铺" Click="SaveShop_Click" Margin="12,0,0,0"/></WrapPanel>
 </StackPanel></ScrollViewer><DataGrid Grid.Column="1" x:Name="ShopsGrid" SelectionChanged="Shop_Selected"><DataGrid.Columns><DataGridTextColumn Header="店铺" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="90"/><DataGridTextColumn Header="平台标识" Binding="{Binding ExternalId}" Width="150"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="商品与单位"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0"><StackPanel><TextBlock Text="SKU 编码（创建后不可改）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SkuCode" MaxLength="100"/><TextBlock Text="商品名称" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SkuName" MaxLength="100"/><TextBlock Text="库存单位" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SkuUnit" Text="件" MaxLength="20"/><CheckBox x:Name="SkuEnabled" Content="启用" IsChecked="True" Margin="0,12,0,0"/><TextBlock Text="组合组件：每行 SKU编码=数量，普通商品留空" Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/><TextBox x:Name="ComponentsBox" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto"/><TextBlock Text="新建商品库存为0；条码请到仓储条码页维护。已有流水或引用的单位与结构不可修改。" TextWrapping="Wrap" Foreground="#63758C" Margin="0,10,0,12"/><WrapPanel><Button Content="新建商品" Click="NewSku_Click" Style="{StaticResource SecondaryButton}"/><Button Content="保存商品" Click="SaveSku_Click" Margin="12,0,0,0"/></WrapPanel></StackPanel></ScrollViewer><DataGrid Grid.Column="1" x:Name="SkusGrid" SelectionChanged="Sku_Selected"><DataGrid.Columns><DataGridTextColumn Header="SKU" Binding="{Binding Code}" Width="150"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="60"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="批量映射"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,12"><TextBlock Text="CSV列：平台,店铺标识,平台商品ID,平台SKU,内部SKU编码,倍率,启用。支持中文平台名；启用填true或false。每批最多200条。" TextWrapping="Wrap" Foreground="#63758C"/><WrapPanel Margin="0,10,0,0"><Button Content="载入待映射" Click="Unmapped_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/><Button Content="导入映射 CSV" Click="ImportMapping_Click"/><Button Content="校验预览" Click="PreviewMappings_Click" Margin="12,0,0,0"/><Button Content="提交本批映射" Click="SaveMappings_Click" Margin="12,0,0,0"/><Button Content="清空编辑表" Click="ClearMappings_Click" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"/></WrapPanel></StackPanel><DataGrid Grid.Row="1" x:Name="MappingsGrid" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True"><DataGrid.Columns><DataGridTextColumn Header="平台" Binding="{Binding PlatformName}" Width="85"/><DataGridTextColumn Header="店铺标识" Binding="{Binding ShopExternalId}" Width="130"/><DataGridTextColumn Header="平台商品ID" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="平台SKU" Binding="{Binding Variant}" Width="*"/><DataGridTextColumn Header="内部SKU编码" Binding="{Binding SkuCode}" Width="150"/><DataGridTextColumn Header="倍率" Binding="{Binding Multiplier}" Width="70"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="原版本" Binding="{Binding ExpectedVersion}" IsReadOnly="True" Width="65"/></DataGrid.Columns></DataGrid><TextBox Grid.Row="2" x:Name="MappingPreviewText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/></Grid></TabItem>
 <TabItem Header="期初库存"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,18,0"><StackPanel><TextBlock Text="期初单号" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpeningNumber" MaxLength="100"/><TextBlock Text="明细：每行 SKU编码,数量（不含表头）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="OpeningLinesBox" Height="150" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><TextBlock Text="仅限无库存流水的普通商品。保存为待审核单，审核才入账；同一SKU只能录入一次期初。" TextWrapping="Wrap" Foreground="#63758C" Margin="0,12,0,12"/><Button Content="保存期初待审核单" Click="CreateOpening_Click"/><Button Content="保存所选草稿修改" Click="EditOpening_Click" Margin="0,12,0,0"/><Button Content="作废所选草稿" Click="VoidOpening_Click" Margin="0,12,0,0" Style="{StaticResource SecondaryButton}"/><CheckBox x:Name="SeparateApproval" Content="期初必须由另一人审核" Margin="0,12,0,0"/><Button Content="申请变更审核策略" Click="SavePolicy_Click" Margin="0,12,0,0" Style="{StaticResource SecondaryButton}"/><TextBlock Text="策略申请需另一账号批准后生效" TextWrapping="Wrap" Margin="0,10,0,0"/><DataGrid x:Name="PolicyChangesGrid" Height="115" AutoGenerateColumns="False"><DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding State}"/><DataGridCheckBoxColumn Header="双审" Binding="{Binding RequireDifferentApprover}"/><DataGridTextColumn Header="申请人ID" Binding="{Binding RequestedBy}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="批准所选策略申请" Click="ApprovePolicy_Click" Margin="0,10,0,0"/><Button Content="审核所选期初单并入账" Click="ApproveOpening_Click" Margin="0,12,0,0"/><TextBlock x:Name="OpeningDetail" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer><DataGrid Grid.Column="1" x:Name="OpeningsGrid" SelectionChanged="Opening_Selected"><DataGrid.Columns><DataGridTextColumn Header="期初单号" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="90"/><DataGridTextColumn Header="制单人" Binding="{Binding CreatedBy}" Width="150"/><DataGridTextColumn Header="审核人" Binding="{Binding ApprovedBy}" Width="150"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 <TabItem Header="变更历史"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="HistoryTitle" Text="从其他页选择资料后，点击‘查看所选资料历史’。最多显示最近100条。" Margin="0,0,0,12" TextWrapping="Wrap"/><DataGrid Grid.Row="1" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="160"/><DataGridTextColumn Header="操作人" Binding="{Binding Actor}" Width="230"/><DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*"/><DataGridTextColumn Header="时间（UTC）" Binding="{Binding CreatedAt}" Width="250"/></DataGrid.Columns></DataGrid></Grid></TabItem>
 </TabControl><DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="操作原因" VerticalAlignment="Center" Margin="0,0,14,0"/><TextBox x:Name="ReasonBox" MaxLength="500" ToolTip="所有保存和审核操作都需要填写原因"/></DockPanel><TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#37628D" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </Grid>
</Window>
