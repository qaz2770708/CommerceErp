<UserControl x:Class="CommerceErp.Desktop.OrdersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid Columns="4" Margin="0,0,0,14">
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="订单总数" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Dashboard.TotalOrders}" FontSize="27" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="待审核" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Dashboard.PendingOrders}" FontSize="27" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0"><StackPanel><TextBlock Text="已审核订单" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Dashboard.ApprovedOrders}" FontSize="27" Foreground="#087E64" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="16,12"><StackPanel><TextBlock Text="异常 / 挂起" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Dashboard.ExceptionOrders}" FontSize="27" Foreground="#B54708" FontWeight="SemiBold"/></StackPanel></Border>
    </UniformGrid>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12" IsEnabled="{Binding IsReady}">
      <TextBlock Text="订单号" VerticalAlignment="Center" Margin="0,0,8,5"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="195" ToolTip="按外部订单号搜索" Margin="0,0,8,5"/>
      <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" DisplayMemberPath="Name" Width="130" Margin="0,0,8,5"/>
      <Button Content="人工订单录入" Command="{Binding ManualOrderCommand}" Margin="0,0,8,5"/><Button Content="查询 / 刷新" Command="{Binding RefreshCommand}" Margin="0,0,8,5"/>
      <Button Content="{Binding PendingText}" Command="{Binding RetryCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,5"/>
    </WrapPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10"><Button Content="打开详情 →" Command="{Binding OpenCommand}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="10,7"/><TextBlock Text="全部平台订单" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/></DockPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" RowHeight="45" HorizontalScrollBarVisibility="Auto" IsEnabled="{Binding IsReady}">
            <DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="订单号" Binding="{Binding ExternalOrderId}" Width="210"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="平台" Binding="{Binding PlatformName}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="状态" Binding="{Binding StateText}" Width="85"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="履约" Binding="{Binding ShippingText}" Width="90"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="售后处理中" Binding="{Binding Source.ActiveAfterSales}" Width="110"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="实付" Binding="{Binding PaidAmount, StringFormat={}{0:F2}}" Width="80"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="异常原因" Binding="{Binding IssueSummary}" Width="250"/></DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="2" Margin="0,12,0,0"><Button Content="下一页" Command="{Binding NextCommand}" DockPanel.Dock="Right" Padding="10,7" Style="{StaticResource SecondaryButton}"/><Button Content="上一页" Command="{Binding PreviousCommand}" DockPanel.Dock="Right" Padding="10,7" Margin="0,0,8,0" Style="{StaticResource SecondaryButton}"/><TextBlock Text="{Binding PageText}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
        <TabControl BorderThickness="0" Background="White" SelectedIndex="{Binding EditorTab}">
          <TabItem Header="订单详情" Padding="12,8"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,12,4,4">
            <TextBlock Text="{Binding DetailTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding DetailState}" Foreground="#37628D" Margin="0,6,0,10"/>
            <WrapPanel><Button Content="审核 / 重审" Command="{Binding ReviewCommand}" Margin="0,0,8,6"/><Button Content="取消并释放" Command="{Binding CancelCommand}" Background="#AC443C" Margin="0,0,0,6"/></WrapPanel>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" ToolTip="取消或更正原因，必填" MaxLength="500" IsEnabled="{Binding IsReady}"/>
            <TextBlock Text="取消或更正前请填写原因；取消后不可恢复预占。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,8"/>
            <ItemsControl ItemsSource="{Binding Details.Issues}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#FFF4E8" Padding="10" Margin="0,0,0,5" CornerRadius="5"><TextBlock Text="{Binding Message}" Foreground="#A45A19" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="商品明细与映射快照" Style="{StaticResource FieldLabel}"/>
            <DataGrid ItemsSource="{Binding Details.Normalized.Lines}" Height="120" RowHeight="34" ColumnHeaderHeight="32"><DataGrid.Columns><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="内部 SKU" Binding="{Binding InternalSkuCode}" Width="*"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="数量" Binding="{Binding OrderedQuantity}" Width="65"/><DataGridTextColumn ElementStyle="{StaticResource GridValue}" Header="映射版" Binding="{Binding MappingVersion}" Width="75"/></DataGrid.Columns></DataGrid>
            <TextBlock Text="组件预占" Style="{StaticResource FieldLabel}"/>
            <ItemsControl ItemsSource="{Binding Details.Reservations}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F4F8FC" Padding="9" Margin="0,0,0,4"><DockPanel><TextBlock Text="{Binding State, Converter={StaticResource BusinessLabel}}" DockPanel.Dock="Right" Foreground="#087E64"/><TextBlock Text="{Binding Quantity, StringFormat= × {0:0.###}}" DockPanel.Dock="Right" Margin="0,0,16,0"/><TextBlock Text="{Binding SkuCode}"/></DockPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="操作轨迹（最新在前）" Style="{StaticResource FieldLabel}"/>
            <ItemsControl ItemsSource="{Binding Details.History}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4EAF2" BorderThickness="0,0,0,1" Padding="0,7"><StackPanel><TextBlock Text="{Binding Reason}" FontSize="12"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm:ss}}" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding RuleVersion, StringFormat= · {0}}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem Header="模拟接单" Padding="12,8"><Grid Margin="4,12,4,4" IsEnabled="{Binding IsReady}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ComboBox ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" DisplayMemberPath="Title"/>
            <WrapPanel Grid.Row="1" Margin="0,9,0,9"><Button Content="生成新模拟单" Command="{Binding NewSampleCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,12,0"/><CheckBox Content="接入后自动审单" IsChecked="{Binding AutoReview}" VerticalAlignment="Center"/></WrapPanel>
            <TextBox Grid.Row="2" Text="{Binding InputJson, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" AcceptsTab="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <StackPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="再次接入相同 JSON 会去重；修改外部单号代表新订单。" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/><Button Content="接入当前订单" Command="{Binding ImportCommand}" HorizontalAlignment="Left"/></StackPanel>
          </Grid></TabItem>
          <TabItem Header="更正来源" Padding="12,8"><Grid Margin="4,12,4,4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="仅待审核、异常或挂起订单可更正。订单归属和外部单号不可修改；保存后需重新审核。" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
            <TextBox Grid.Row="1" Text="{Binding CorrectionJson, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanCorrect}" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
            <StackPanel Grid.Row="2" Margin="0,10,0,0"><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" ToolTip="必填：更正原因" MaxLength="500"/><Button Content="保存更正与历史快照" Command="{Binding CorrectCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
          </Grid></TabItem>
        </TabControl>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Message}" Foreground="#37628D" Margin="0,12,0,0" FontSize="12" MaxHeight="52" ToolTip="{Binding Message}"/>
  </Grid>
</UserControl>
