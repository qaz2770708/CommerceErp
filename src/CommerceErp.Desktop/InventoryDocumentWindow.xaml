<Window x:Class="CommerceErp.Desktop.InventoryDocumentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="库存调整、盘点与隔离处置" Width="1340" Height="900" MinWidth="1100" MinHeight="760" FontFamily="Microsoft YaHei UI" Background="#F4F7FC" WindowStartupLocation="CenterOwner">
<Grid Margin="20" Background="#F4F7FC"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="库存单据" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="草稿不改库存；审核须另一账号。盘点含已预占、冻结的实物；隔离库存独立记录。版本变化须重新核对。" TextWrapping="Wrap" Foreground="#63758C" Margin="0,8,0,12"/>
<WrapPanel><TextBox x:Name="SearchBox" Width="180" ToolTip="按单号搜索"/><ComboBox x:Name="StateBox" Width="120" Margin="8,0"/><Button Content="查询" Click="Search_Click"/><Button Content="上一页" Click="Previous_Click" Style="{StaticResource SecondaryButton}" Margin="8,0"/><Button Content="下一页" Click="Next_Click" Style="{StaticResource SecondaryButton}"/><Button Content="单据核对" Click="Audit_Click" Margin="8,0"/><TextBlock x:Name="PageText" VerticalAlignment="Center"/></WrapPanel></StackPanel>
<Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="DocumentsGrid" MouseDoubleClick="Open_Click"><DataGrid.Columns><DataGridTextColumn Header="单号" Binding="{Binding Number}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="80"/><DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="50"/></DataGrid.Columns></DataGrid><Button Grid.Row="1" Content="打开所选单据" Click="Open_Click" Margin="0,10,0,0"/></Grid>
<TabControl Grid.Column="1" x:Name="EditorTabs"><TabItem Header="单据与明细"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><WrapPanel><Button Content="新建" Click="New_Click" Style="{StaticResource SecondaryButton}"/><ComboBox x:Name="KindBox" DisplayMemberPath="Name" Width="180" Margin="10,0"/><TextBox x:Name="NumberBox" Width="230" ToolTip="单号" MaxLength="100"/></WrapPanel><TextBlock Text="数量：调整填正负增减量；盘点填良品实盘数及隔离实盘数；隔离处置填正数量。SKU编码必填。" TextWrapping="Wrap" Foreground="#63758C" Margin="0,10,0,6"/><Button Content="核对当前账面 / 重盘后刷新版本" Click="Capture_Click" HorizontalAlignment="Left"/></StackPanel>
<DataGrid Grid.Row="1" x:Name="LinesGrid" IsReadOnly="False" CanUserAddRows="True" CanUserDeleteRows="True" Margin="0,12,0,12"><DataGrid.Columns><DataGridTextColumn Header="SKU编码" Binding="{Binding Code}" Width="120"/><DataGridTextColumn Header="数量/良品实盘" Binding="{Binding Value}" Width="105"/><DataGridTextColumn Header="隔离实盘" Binding="{Binding QuarantineCount}" Width="90"/><DataGridTextColumn Header="已存良品变动" Binding="{Binding StoredHandDelta}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="已存隔离变动" Binding="{Binding StoredQuarantineDelta}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="账面良品" Binding="{Binding BookOnHand}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="账面隔离" Binding="{Binding BookQuarantine}" IsReadOnly="True" Width="90"/><DataGridTextColumn Header="预占" Binding="{Binding Reserved}" IsReadOnly="True" Width="70"/><DataGridTextColumn Header="冻结" Binding="{Binding Frozen}" IsReadOnly="True" Width="70"/></DataGrid.Columns></DataGrid>
<StackPanel Grid.Row="2"><TextBlock Text="依据/实物凭证（退供填写接收方及出库凭证；冲销填写实物核查依据）" TextWrapping="Wrap"/><TextBox x:Name="EvidenceBox" MaxLength="1000" Height="44" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8"/><TextBlock Text="本次操作原因"/><TextBox x:Name="ReasonBox" MaxLength="500" Height="44" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,4,0,8"/>
<WrapPanel><Button x:Name="CreateButton" Content="保存新草稿" Click="Create_Click"/><Button x:Name="EditButton" Content="保存草稿修改" Click="Edit_Click" Margin="8,0"/><Button x:Name="VoidButton" Content="作废草稿" Click="Void_Click" Style="{StaticResource SecondaryButton}"/><Button x:Name="ApproveButton" Content="审核入账" Click="Approve_Click" Margin="8,0"/><Button x:Name="ReverseButton" Content="发起冲销草稿" Click="Reverse_Click" Style="{StaticResource SecondaryButton}"/></WrapPanel></StackPanel>
</Grid></TabItem><TabItem Header="流水与操作历史"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><DataGrid x:Name="MovementsGrid" AutoGenerateColumns="True"/><DataGrid Grid.Row="1" x:Name="HistoryGrid" AutoGenerateColumns="True" Margin="0,12,0,0"/></Grid></TabItem></TabControl></Grid><TextBlock Grid.Row="2" x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#37628D"/>
</Grid></Window>
