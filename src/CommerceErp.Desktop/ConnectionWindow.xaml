<Window x:Class="CommerceErp.Desktop.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ERP 服务连接" Width="640" Height="630" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F4F7FC">
  <Grid Margin="32" Background="#F4F7FC">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="选择工作区连接" FontSize="25" FontWeight="SemiBold" Foreground="#153052"/><TextBlock Text="本地工作区独立保存；共享服务供多个客户端共同使用。" Margin="0,9,0,20" Foreground="#63758C"/></StackPanel>
    <StackPanel Grid.Row="1">
      <ComboBox x:Name="ModeBox" SelectedIndex="0" Margin="0,0,0,18"><ComboBoxItem Content="本地模式"/><ComboBoxItem Content="连接独立服务"/></ComboBox>
      <TextBlock Text="服务地址" Margin="0,0,0,6"/><TextBox x:Name="UrlBox" Text="http://127.0.0.1:5088"/>
      <TextBlock Text="访问令牌" Margin="0,16,0,6"/><PasswordBox x:Name="TokenBox" Padding="9" Background="White" BorderBrush="#CED9E8" BorderThickness="1"/>
      <CheckBox x:Name="RememberBox" Content="使用当前 Windows 用户密钥保存令牌" Margin="0,12,0,0"/>
      <TextBlock Text="默认每次启动输入令牌。勾选保存后仅当前 Windows 用户可解密。" FontSize="11" Foreground="#63758C" Margin="0,7,0,0" TextWrapping="Wrap"/>
      <CheckBox x:Name="NewProfileBox" Content="为此服务器建立新连接档案（保留原档案与待重试记录）" Margin="0,12,0,0"/>
    </StackPanel>
    <Border Grid.Row="2" Background="#EAF1FF" CornerRadius="7" Padding="14" Margin="0,22,0,18" VerticalAlignment="Top">
      <TextBlock x:Name="StatusText" Text="保存后在下次启动生效。连接令牌用于服务入口；进入业务还需登录个人账号。" TextWrapping="Wrap" Foreground="#37628D" LineHeight="22"/>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="TestButton" Content="测试连接" Click="Test_Click" Margin="0,0,10,0"/><Button x:Name="SaveButton" Content="保存设置" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
